{
  "manifest_version": 3,
  "name": "Facebook Keyword Video Filter",
  "version": "1.0.0",
  "description": "Hide Facebook posts and videos that contain user-defined keywords.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook Keyword Video Filter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
